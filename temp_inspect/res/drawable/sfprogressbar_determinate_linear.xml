<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@id/sfprogressbar_track">
        <shape android:shape="rectangle">
            <size android:height="4.0dip" />
            <solid android:color="#ffd4e5f9" />
        </shape>
    </item>
    <item android:id="@id/sfprogressbar_secondary_progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <size android:height="4.0dip" />
                <solid android:color="#ff85c0f7" />
            </shape>
        </scale>
    </item>
    <item android:id="@id/sfprogressbar_progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <size android:height="4.0dip" />
                <solid android:color="#ff007cee" />
            </shape>
        </scale>
    </item>
</layer-list>
