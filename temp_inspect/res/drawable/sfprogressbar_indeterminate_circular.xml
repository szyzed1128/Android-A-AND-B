<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@id/sfprogressbar_track">
        <rotate android:fromDegrees="0.0" android:toDegrees="0.0" android:pivotX="50.0%" android:pivotY="50.0%">
            <shape android:shape="ring" android:innerRadiusRatio="2.85" android:thicknessRatio="40.0">
                <solid android:color="#ffd4e5f9" />
            </shape>
        </rotate>
    </item>
    <item android:id="@id/sfprogressbar_progress">
        <rotate android:fromDegrees="0.0" android:toDegrees="0.0" android:pivotX="50.0%" android:pivotY="50.0%">
            <shape android:shape="ring" android:innerRadiusRatio="2.85" android:thicknessRatio="40.0">
                <solid android:color="#ff007cee" />
            </shape>
        </rotate>
    </item>
</layer-list>
