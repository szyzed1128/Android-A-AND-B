<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>OBDCloud.WebSocket</AssemblyName>
    <RootNamespace>OBDCloud.WebSocket</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebSocketIOBDConnectionProxy.cs 需要用 Mono 编译器单独编译（因为它需要 Mono 的 ValueTask） -->
    <Compile Remove="src/WebSocketIOBDConnectionProxy.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>../../temp_verify/unknown/assemblies/Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp">
      <HintPath>../../temp_verify/unknown/assemblies/Microsoft.CSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
